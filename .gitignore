# Xcode build output
build/
DerivedData/
*.xcuserdatad/
xcuserdata/
*.log

# Swift Package Manager
# Package.resolved IS tracked — Xcode Cloud resolves from it.
.swiftpm/
.build/
Packages/
Package.pins

# Node — this repo has no JavaScript. Anything here is a mistake.
node_modules/

# Screenshots and scratch images, but never the asset catalog
*.png
*.jpg
*.jpeg
!TaxedGmbH_IOS/Resources/Assets/**/*.png
!TaxedGmbH_IOS/Resources/Assets/**/*.jpg

# macOS
.DS_Store

# Secrets. GoogleService-Info.plist is public-by-design (API keys in it are
# identifiers, not credentials) and IS tracked; nothing else here should be.
*.p8
*.p12
*.mobileprovision
