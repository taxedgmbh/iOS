// Terms
"terms.acceptance.content" = "Durch die Nutzung der TaxedGmbH-Dienste stimmen Sie diesen Nutzungsbedingungen zu. Wenn Sie nicht zustimmen, nutzen Sie bitte unsere Dienste nicht.";
"terms.acceptance.title" = "1. Annahme der Bedingungen";
"terms.contact.content" = "Für Fragen zu diesen Bedingungen: legal@taxed.ch\nFür Datenschutzanfragen: privacy@taxed.ch\nPostadresse: TaxedGmbH, Aegertenstrasse 10, 2503 Biel/Bienne, Schweiz\nTelefon: +41 79 910 77 87";
"terms.contact.title" = "11. Kontaktinformationen";
"terms.data_protection.content" = "Wir halten das revidierte Schweizer Datenschutzgesetz (revDSG, gültig seit September 2023) und die EU-DSGVO ein. Ihre Rechte umfassen Zugang, Berichtigung, Löschung, Datenübertragbarkeit und Widerspruch gegen die Verarbeitung. Kontaktieren Sie unseren Datenschutzbeauftragten unter privacy@taxed.ch oder den EDÖB für Beschwerden.";
"terms.data_protection.title" = "8. Datenschutz-Compliance";
"terms.data_security.content" = "Ihre Daten werden auf Google Cloud Firestore-Servern ausschliesslich in Zürich, Schweiz (Region: europe-west6) gespeichert. Alle Daten werden mit AES-256-Verschlüsselung im Ruhezustand und TLS 1.3 bei der Übertragung verschlüsselt. Wir halten das Schweizer Datenschutzgesetz (DSG) und die DSGVO ein. Ihre Daten bleiben jederzeit innerhalb der Schweizer/EU-Gerichtsbarkeit. Siehe unsere Datenschutzerklärung für detaillierte Informationen.";
"terms.data_security.title" = "5. Datenspeicherung und Sicherheit";
"terms.fees.content" = "Unsere Gebührenstruktur ist transparent und wird vor jedem Kauf angezeigt. Alle Gebühren sind in Schweizer Franken (CHF) und enthalten die geltenden Steuern.";
