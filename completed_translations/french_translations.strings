// Privacy
"privacy.data_retention.content" = "Les documents fiscaux sont conservés pendant 10 ans conformément à l'article 958f CO. Les données personnelles du compte sont conservées tant que votre compte est actif. Vous pouvez demander la suppression de données non essentielles à tout moment, sous réserve des exigences légales de conservation.";
"privacy.data_retention.title" = "Conservation des données";
"privacy.rights.content" = "Vous avez le droit d'accéder à vos données (Art. 15 RGPD / Art. 25 LPD), de rectifier les données inexactes (Art. 16 RGPD / Art. 32 LPD), de demander la suppression (Art. 17 RGPD / Art. 32 LPD), la portabilité des données (Art. 20 RGPD), de vous opposer au traitement (Art. 21 RGPD / Art. 30 LPD) et de déposer des plaintes auprès du PFPDT. Contactez privacy@taxed.ch pour exercer ces droits.";
"privacy.rights.title" = "Vos droits (RGPD et LPD suisse)";
"privacy.security.content" = "Mesures techniques : cryptage AES-256 au repos, TLS 1.3 en transit, authentification multi-facteurs, contrôle d'accès basé sur les rôles, surveillance automatisée de la sécurité. Mesures organisationnelles : audits de sécurité réguliers, formation du personnel, procédures de réponse aux incidents, protocoles de sauvegarde et de récupération. Infrastructure : centres de données Google Cloud Platform Tier 4 avec sécurité physique 24/7.";
"privacy.security.title" = "Mesures de sécurité";

