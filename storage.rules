rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if file size is within limit (4 MB)
    function isValidSize() {
      return request.resource.size <= 4 * 1024 * 1024;  // 4 MB limit
    }

    // Helper function to check if file is a valid document type
    function isValidFileType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType == 'application/pdf';
    }

    // Helper function to check if user is a workspace member
    function isWorkspaceMember(workspaceId, userId) {
      let workspace = firestore.get(/databases/taxedgmbh/documents/workspaces/$(workspaceId));
      return workspace != null &&
             workspace.data.memberIds != null &&
             userId in workspace.data.memberIds;
    }

    // Helper function to check if user can edit workspace documents
    function canEditWorkspace(workspaceId, userId) {
      let workspace = firestore.get(/databases/taxedgmbh/documents/workspaces/$(workspaceId));
      return workspace != null &&
             workspace.data.memberIds != null &&
             userId in workspace.data.memberIds;
    }

    // Helper function to check if user has admin access (can delete)
    function hasWorkspaceAdminAccess(workspaceId, userId) {
      let workspace = firestore.get(/databases/taxedgmbh/documents/workspaces/$(workspaceId));
      return workspace != null &&
             workspace.data.ownerId == userId;
    }

    // Profile images: users/{userId}/profile_images/{fileName}
    match /profile_images/{fileName} {
      // Extract userId from filename (format: {userId}.jpg)
      allow read: if isAuthenticated();

      allow write: if isAuthenticated() &&
                     isValidSize() &&
                     request.resource.contentType.matches('image/.*');
    }

    // Workspace-centric storage: workspaces/{workspaceId}/{taxYear}/{documentId}/{fileType}
    // All document-related files (original.pdf, cover_sheet.pdf, processed.pdf) are stored here
    // Categories and subcategories are stored in Firestore metadata for agility
    // Members of a workspace can collaboratively access and manage documents
    match /workspaces/{workspaceId}/{allPaths=**} {
      // Allow read if:
      // - User is a member of the workspace (checked via Firestore)
      allow read: if isAuthenticated() &&
                    isWorkspaceMember(workspaceId, request.auth.uid);

      // Allow write (create/update) if:
      // - Authenticated user AND
      // - User is a member with edit permissions AND
      // - File size is within limit (4 MB) AND
      // - File type is valid (image or PDF)
      allow write: if isAuthenticated() &&
                     canEditWorkspace(workspaceId, request.auth.uid) &&
                     isValidSize() &&
                     isValidFileType();

      // Allow delete if:
      // - User has admin access to the workspace
      allow delete: if isAuthenticated() &&
                      hasWorkspaceAdminAccess(workspaceId, request.auth.uid);
    }

    // Deny all other paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
