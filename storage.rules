rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if file size is within limit (4 MB)
    function isValidSize() {
      return request.resource.size <= 4 * 1024 * 1024;  // 4 MB limit
    }

    // Helper function to check if file is a valid document type
    function isValidFileType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType == 'application/pdf';
    }

    // NOTE: Workspace membership validation is enforced through multiple security layers:
    // 1. Firestore Rules: Prevent unauthorized workspace/document queries
    // 2. App Logic: Validate membership before showing upload UI
    // 3. UUID Workspace IDs: Provide namespace isolation (not guessable)
    // 4. Storage Rules (below): Validate authentication + file constraints
    //
    // Storage Rules cannot access named Firestore databases (only "(default)").
    // Since this app uses named database "taxedgmbh", we enforce security
    // through Firestore rules and app validation instead of Storage Rules queries.

    // Profile images: users/{userId}/profile_images/{fileName}
    match /profile_images/{fileName} {
      // Extract userId from filename (format: {userId}.jpg)
      allow read: if isAuthenticated();

      allow write: if isAuthenticated() &&
                     isValidSize() &&
                     request.resource.contentType.matches('image/.*');
    }

    // Workspace-centric storage: workspaces/{workspaceId}/{taxYear}/{documentId}/{fileType}
    // All document-related files (original.pdf, cover_sheet.pdf, processed.pdf) are stored here
    // Categories and subcategories are stored in Firestore metadata for agility
    // Members of a workspace can collaboratively access and manage documents
    //
    // SECURITY MODEL:
    // Workspace membership is validated in Firestore rules and app logic.
    // Storage rules enforce authentication + file constraints.
    // UUID workspace IDs provide namespace isolation.
    match /workspaces/{workspaceId}/{allPaths=**} {
      // Read operations (download URLs, file retrieval):
      // - Only require authentication
      // - File constraints (size/type) only apply during upload, not download
      allow read: if isAuthenticated();

      // Write operations (upload):
      // - User is authenticated (Firebase Auth)
      // - File size is within limit (4 MB)
      // - File type is valid (image or PDF)
      //
      // Membership validation handled by:
      // - Firestore rules (prevent unauthorized workspace queries)
      // - App UI (only shows workspaces user is member of)
      allow write: if isAuthenticated() &&
                      isValidSize() &&
                      isValidFileType();

      // Delete requires authentication
      allow delete: if isAuthenticated();
    }

    // Deny all other paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
