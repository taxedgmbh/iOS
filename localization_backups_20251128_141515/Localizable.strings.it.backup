// MARK: - Privacy Policy (New)
"privacy.title" = "Informativa sulla privacy";
"privacy.navigation_title" = "Privacy";
"privacy.section1.title" = "1. Raccolta dati";
"privacy.section1.content" = "Raccogliamo solo i dati necessari per fornire i nostri servizi fiscali. Ciò include informazioni personali, documenti fiscali e informazioni finanziarie che ci fornisci.";
"privacy.section2.title" = "2. Utilizzo dei dati";
"privacy.section2.content" = "I tuoi dati sono utilizzati esclusivamente per la preparazione e la presentazione della tua dichiarazione fiscale. Non vendiamo né condividiamo i tuoi dati con terze parti.";
"privacy.section3.title" = "3. Sicurezza dei dati";
"privacy.section3.content" = "Tutti i dati sono crittografati in transito e a riposo. Utilizziamo standard di sicurezza di livello bancario per proteggere le tue informazioni.";
"privacy.section4.title" = "4. I tuoi diritti";
"privacy.section4.content" = "Hai il diritto di accedere, correggere o eliminare i tuoi dati in qualsiasi momento. Contatta il nostro team di supporto per qualsiasi richiesta relativa alla privacy.";

// MARK: - Terms of Service (New)
"terms.title" = "Condizioni d'uso";
"terms.navigation_title" = "Condizioni";
"terms.section1.title" = "1. Accettazione delle condizioni";
"terms.section1.content" = "Utilizzando Taxed, accetti queste condizioni d'uso. Se non accetti queste condizioni, ti preghiamo di non utilizzare i nostri servizi.";
"terms.section2.title" = "2. Descrizione del servizio";
"terms.section2.content" = "Taxed fornisce servizi professionali di preparazione e presentazione di dichiarazioni fiscali per residenti svizzeri.";
"terms.section3.title" = "3. Responsabilità dell'utente";
"terms.section3.content" = "Sei responsabile di fornire informazioni accurate e complete. Informazioni inesatte possono influire sulla tua dichiarazione fiscale.";
"terms.section4.title" = "4. Limitazione di responsabilità";
"terms.section4.content" = "Sebbene ci impegniamo per garantire l'accuratezza, Taxed non è responsabile per errori derivanti da informazioni inesatte fornite.";

// MARK: - Support (New)
"support.navigation_title" = "Supporto";
"support.header" = "Come possiamo aiutarti?";
"support.footer" = "Il nostro team di supporto è disponibile dal lunedì al venerdì, dalle 9:00 alle 18:00.";
"support.faq" = "Domande frequenti";
"support.online_help" = "Aiuto online";
"support.email" = "Invia email";
