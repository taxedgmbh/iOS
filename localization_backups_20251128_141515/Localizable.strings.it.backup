// MARK: - Privacy Policy (Data Storage)
"privacy.data_storage_auth.title" = "Archiviazione dati di autenticazione";
"privacy.data_storage_auth.content" = "Le informazioni di autenticazione dell'utente (indirizzi e-mail, password crittografate, ID utente) vengono elaborate da Firebase Authentication (Google Cloud Platform) e archiviate negli Stati Uniti. Per i trasferimenti di dati transatlantici, Google mantiene clausole contrattuali standard (SCC) e aderisce all'EU-US Data Privacy Framework e allo Swiss-US Data Privacy Framework, garantendo la conformità ai requisiti del GDPR e della LPD svizzera.";

"privacy.data_storage_app.title" = "Archiviazione dati dell'applicazione";
"privacy.data_storage_app.content" = "Tutti gli altri dati personali, inclusi documenti fiscali, messaggi, cronologia chat e dati dell'applicazione, sono archiviati esclusivamente in Svizzera utilizzando Google Cloud Firestore (ID database: taxedgmbh) situato nella regione di Zurigo (europe-west6). Questi dati sono crittografati a riposo con crittografia AES-256 e in transito con protocollo TLS 1.3. I dati dell'applicazione non lasciano mai la giurisdizione svizzera o dell'UE.";

"privacy.data_processing.title" = "Elaborazione dei dati";
"privacy.data_processing.content" = "Utilizziamo i servizi Firebase (Google Cloud Platform) come responsabile del trattamento dei dati. Firebase è certificato secondo gli standard ISO 27001, ISO 27017, ISO 27018 e SOC 2/3. Sono in atto accordi sul trattamento dei dati (DPA) che garantiscono la conformità al GDPR e alla LPD svizzera. L'elaborazione dei dati dell'applicazione avviene esclusivamente nella regione UE/Svizzera.";

"privacy.data_transfers.title" = "Trasferimenti internazionali di dati";
"privacy.data_transfers.content" = "I dati di autenticazione (e-mail, password) possono essere trasferiti negli Stati Uniti tramite Firebase Authentication. Questi trasferimenti sono protetti da clausole contrattuali standard (SCC) approvate dalla Commissione europea e dall'Incaricato federale della protezione dei dati e della trasparenza (IFPDT). Tutti gli altri dati personali rimangono in Svizzera (Zurigo, europe-west6) e non vengono trasferiti al di fuori della giurisdizione svizzera o dell'UE.";

