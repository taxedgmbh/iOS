// MARK: - Help & Support
"help.title" = "Aiuto & Supporto";
"help.common_questions" = "Domande Frequenti";
"help.support" = "Supporto";

// Iniziare
"help.getting_started" = "Come iniziare";
"help.getting_started.desc" = "I primi passi con Taxed";
"help.getting_started.content" = "Benvenuto in Taxed!\n\n1. Crea il tuo account con email o Apple ID\n2. Completa il tuo profilo\n3. Carica i tuoi documenti fiscali\n4. La nostra IA li analizza e categorizza\n5. Verifica e invia la tua dichiarazione\n\nServe aiuto? Contattaci: info@taxed.ch";

// Caricare documenti
"help.how_upload" = "Come carico i documenti?";
"help.how_upload.desc" = "Guida passo dopo passo";
"help.how_upload.content" = "Caricare i documenti è facile:\n\n1. Apri la scheda Documenti\n2. Tocca '+'\n3. Scegli Fotocamera o Galleria\n4. Scatta una foto o seleziona un'immagine\n5. Conferma il caricamento\n\nLa nostra IA:\n• Analizza il documento\n• Lo categorizza automaticamente\n• Estrae le informazioni chiave\n• Convalida i dati\n\nSupporto: info@taxed.ch";

// Tasse per expatriati
"help.expat_taxes" = "Come funzionano le tasse per expat?";
"help.expat_taxes.desc" = "Requisiti specifici per expat";
"help.expat_taxes.content" = "Come expat in Svizzera, devi:\n\n• Dichiarare tutti i redditi svizzeri\n• Dichiarare redditi e patrimoni esteri\n• Utilizzare convenzioni fiscali\n• Presentare certificati fiscali esteri\n• Documentare cassa pensioni (2°/3° pilastro)\n• Fornire permessi di soggiorno\n\nTi supportiamo con:\n• Richieste automatiche di convenzioni\n• Calcoli redditi esteri\n• Assistenza multilingue\n• Consulenza esperta\n\nContatto: info@taxed.ch\nTelefono: +41 79 910 77 87";

// Scadenze fiscali
"help.deadlines" = "Quali sono le scadenze fiscali?";
"help.deadlines.desc" = "Date importanti e proroghe";
"help.deadlines.content" = "Calendario fiscale svizzero:\n\n• 31 marzo: Scadenza regolare\n• Maggio-Giugno: Scadenza prorogata (su richiesta)\n• Settembre: Proroga massima (con consulente)\n\nVantaggi expat:\n• Proroghe automatiche\n• Tempo aggiuntivo per documenti esteri\n• Supporto professionale incluso\n\nProroga? Contatto: info@taxed.ch";

// Protezione dati
"help.account_privacy" = "Come vengono protetti i miei dati?";
"help.account_privacy.desc" = "Misure di sicurezza e privacy";
"help.account_privacy.content" = "La sicurezza dei tuoi dati è la nostra priorità:\n\n• Crittografia end-to-end\n• Conformità legge svizzera protezione dati\n• Archiviazione cloud sicura (AWS)\n• Audit di sicurezza regolari\n• Nessuna condivisione con terzi\n\nPuoi:\n• Esportare i tuoi dati in qualsiasi momento\n• Eliminare il tuo account\n• Richiedere correzioni\n\nDomande privacy: info@taxed.ch";

// Prezzi
"help.pricing" = "Quanto costa il servizio?";
"help.pricing.desc" = "Informazioni prezzi trasparenti";
"help.pricing.content" = "I nostri prezzi sono semplici e trasparenti:\n\n• Dichiarazione fiscale base: CHF 99\n• Servizi expat: CHF 149\n• Casi complessi: CHF 199\n• Consulenza esperto: CHF 50/ora\n\nIncluso in tutti i pacchetti:\n• Caricamenti illimitati\n• Analisi IA\n• Supporto via email\n• Archiviazione sicura\n\nDomande: info@taxed.ch";

// Contattare supporto
"help.contact" = "Come contatto il supporto?";
"help.contact.desc" = "Contatta il nostro team";
"help.contact.content" = "Siamo qui per aiutarti!\n\nE-mail: info@taxed.ch\nTelefono: +41 79 910 77 87\n\nOrari ufficio:\nLunedì - Venerdì: 9:00 - 18:00\nSabato: Chiuso\nDomenica: Chiuso\n\nUfficio:\nTaxed GmbH\nAegertenstrasse 10\n2503 Biel/Bienne\nSvizzera\n\nTempo di risposta medio: 2-4 ore";

