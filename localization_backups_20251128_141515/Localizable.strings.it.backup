// MARK: - FAQ (New)
"faq.navigation_title" = "FAQ";
"faq.section.general" = "Generale";
"faq.section.documents" = "Documenti";
"faq.general.how_it_works.question" = "Come funziona Taxed?";
"faq.general.how_it_works.answer" = "Taxed semplifica la tua dichiarazione fiscale in 4 semplici passaggi: 1) Carica i tuoi documenti, 2) La nostra IA li analizza, 3) I nostri esperti verificano tutto, 4) Presentiamo la tua dichiarazione fiscale.";
"faq.general.is_secure.question" = "È sicuro?";
"faq.general.is_secure.answer" = "Sì! Utilizziamo crittografia di livello bancario e tutti i server si trovano in Svizzera. I tuoi dati non lasciano mai il territorio svizzero.";
"faq.documents.which_needed.question" = "Quali documenti sono necessari?";
"faq.documents.which_needed.answer" = "In generale, hai bisogno di: certificati di stipendio, estratti conto bancari, ricevute per deduzioni e altri documenti pertinenti per i tuoi redditi e spese.";
"faq.documents.how_upload.question" = "Come caricare i documenti?";
"faq.documents.how_upload.answer" = "Usa semplicemente la funzione fotocamera per scattare foto dei tuoi documenti o carica file direttamente dal tuo dispositivo. La nostra IA li elaborerà automaticamente.";

