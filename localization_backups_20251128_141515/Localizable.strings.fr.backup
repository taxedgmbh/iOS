// MARK: - Privacy Policy (New)
"privacy.title" = "Politique de confidentialité";
"privacy.navigation_title" = "Confidentialité";
"privacy.section1.title" = "1. Collecte des données";
"privacy.section1.content" = "Nous collectons uniquement les données nécessaires pour fournir nos services fiscaux. Cela inclut les informations personnelles, les documents fiscaux et les informations financières que vous nous fournissez.";
"privacy.section2.title" = "2. Utilisation des données";
"privacy.section2.content" = "Vos données sont utilisées exclusivement pour la préparation et la soumission de votre déclaration fiscale. Nous ne vendons ni ne partageons vos données avec des tiers.";
"privacy.section3.title" = "3. Sécurité des données";
"privacy.section3.content" = "Toutes les données sont cryptées en transit et au repos. Nous utilisons des normes de sécurité de niveau bancaire pour protéger vos informations.";
"privacy.section4.title" = "4. Vos droits";
"privacy.section4.content" = "Vous avez le droit d'accéder, de corriger ou de supprimer vos données à tout moment. Contactez notre équipe d'assistance pour toute demande relative à la confidentialité.";

// MARK: - Terms of Service (New)
"terms.title" = "Conditions d'utilisation";
"terms.navigation_title" = "Conditions";
"terms.section1.title" = "1. Acceptation des conditions";
"terms.section1.content" = "En utilisant Taxed, vous acceptez ces conditions d'utilisation. Si vous n'acceptez pas ces conditions, veuillez ne pas utiliser nos services.";
"terms.section2.title" = "2. Description du service";
"terms.section2.content" = "Taxed fournit des services professionnels de préparation et de soumission de déclarations fiscales pour les résidents suisses.";
"terms.section3.title" = "3. Responsabilités de l'utilisateur";
"terms.section3.content" = "Vous êtes responsable de fournir des informations précises et complètes. Les informations inexactes peuvent affecter votre déclaration fiscale.";
"terms.section4.title" = "4. Limitation de responsabilité";
"terms.section4.content" = "Bien que nous nous efforcions d'assurer l'exactitude, Taxed n'est pas responsable des erreurs résultant d'informations inexactes fournies.";

