// MARK: - Help & Support
"help.title" = "Aide & Support";
"help.common_questions" = "Questions Fréquentes";
"help.support" = "Support";

// Premiers pas
"help.getting_started" = "Premiers pas";
"help.getting_started.desc" = "Débuter avec Taxed";
"help.getting_started.content" = "Bienvenue chez Taxed!\n\n1. Créez votre compte avec e-mail ou Apple ID\n2. Complétez votre profil\n3. Téléchargez vos documents fiscaux\n4. Notre IA les analyse et les catégorise\n5. Vérifiez et soumettez votre déclaration\n\nBesoin d'aide? Contactez-nous: info@taxed.ch";

// Télécharger des documents
"help.how_upload" = "Comment télécharger des documents?";
"help.how_upload.desc" = "Guide étape par étape";
"help.how_upload.content" = "Télécharger des documents est facile:\n\n1. Ouvrez l'onglet Documents\n2. Appuyez sur '+'\n3. Choisissez Caméra ou Galerie\n4. Prenez une photo ou sélectionnez une image\n5. Confirmez le téléchargement\n\nNotre IA:\n• Analyse le document\n• Le catégorise automatiquement\n• Extrait les informations clés\n• Valide les données\n\nSupport: info@taxed.ch";

// Impôts pour expatriés
"help.expat_taxes" = "Comment fonctionnent les impôts pour expatriés?";
"help.expat_taxes.desc" = "Exigences spécifiques aux expatriés";
"help.expat_taxes.content" = "En tant qu'expatrié en Suisse, vous devez:\n\n• Déclarer tous les revenus suisses\n• Déclarer les revenus et actifs étrangers\n• Utiliser les conventions fiscales\n• Soumettre les certificats fiscaux étrangers\n• Documenter la caisse de pension (2e/3e pilier)\n• Fournir les permis de séjour\n\nNous vous accompagnons avec:\n• Demandes automatiques de conventions\n• Calculs de revenus étrangers\n• Assistance multilingue\n• Consultation d'expert\n\nContact: info@taxed.ch\nTéléphone: +41 79 910 77 87";

// Délais fiscaux
"help.deadlines" = "Quels sont les délais fiscaux?";
"help.deadlines.desc" = "Dates importantes et prolongations";
"help.deadlines.content" = "Calendrier fiscal suisse:\n\n• 31 mars: Délai régulier\n• Mai-Juin: Délai prolongé (sur demande)\n• Septembre: Prolongation maximale (avec conseiller)\n\nAvantages expatriés:\n• Prolongations automatiques\n• Temps supplémentaire pour documents étrangers\n• Support professionnel inclus\n\nProlongation? Contact: info@taxed.ch";

// Protection des données
"help.account_privacy" = "Comment mes données sont-elles protégées?";
"help.account_privacy.desc" = "Mesures de sécurité et confidentialité";
"help.account_privacy.content" = "La sécurité de vos données est notre priorité:\n\n• Cryptage de bout en bout\n• Conformité loi suisse sur protection des données\n• Stockage cloud sécurisé (AWS)\n• Audits de sécurité réguliers\n• Aucun partage avec des tiers\n\nVous pouvez:\n• Exporter vos données à tout moment\n• Supprimer votre compte\n• Demander des corrections\n\nQuestions confidentialité: info@taxed.ch";

// Tarifs
"help.pricing" = "Combien coûte le service?";
"help.pricing.desc" = "Informations tarifaires transparentes";
"help.pricing.content" = "Nos prix sont simples et transparents:\n\n• Déclaration fiscale de base: CHF 99\n• Services expatriés: CHF 149\n• Cas complexes: CHF 199\n• Consultation expert: CHF 50/heure\n\nInclus dans tous les forfaits:\n• Téléchargements illimités\n• Analyse IA\n• Support par e-mail\n• Stockage sécurisé\n\nQuestions: info@taxed.ch";

// Contacter le support
"help.contact" = "Comment contacter le support?";
"help.contact.desc" = "Contactez notre équipe";
"help.contact.content" = "Nous sommes là pour vous aider!\n\nE-mail: info@taxed.ch\nTéléphone: +41 79 910 77 87\n\nHeures d'ouverture:\nLundi - Vendredi: 9h00 - 18h00\nSamedi: Fermé\nDimanche: Fermé\n\nBureau:\nTaxed GmbH\nAegertenstrasse 10\n2503 Bienne/Biel\nSuisse\n\nTemps de réponse moyen: 2-4 heures";

