// MARK: - About
"about.tagline" = "Votre Déclaration Fiscale Suisse - Simple et Digitale";
"about.description" = "Taxed GmbH est votre partenaire digital pour les déclarations fiscales suisses. Nous combinons technologie de pointe et expertise fiscale pour rendre le processus fiscal aussi simple que possible.";
"about.mission" = "Notre Mission";
"about.mission.content" = "Nous croyons que la déclaration fiscale devrait être simple, transparente et sans stress. Notre mission est d'aider tous les résidents en Suisse - locaux et expatriés - à naviguer le système fiscal avec confiance.";
"about.company_name" = "Entreprise";
"about.location" = "Localisation";
"about.contact" = "Contact";

// MARK: - Privacy Policy
"privacy.last_updated" = "Dernière Mise à Jour: Janvier 2025";
"privacy.intro.title" = "1. Introduction";
"privacy.intro.content" = "Taxed GmbH respecte votre vie privée et s'engage à protéger vos données personnelles. Cette politique de confidentialité vous informe sur la façon dont nous collectons, utilisons et protégeons vos données.";
"privacy.data_collection.title" = "2. Collecte de Données";
"privacy.data_collection.content" = "Nous collectons les données suivantes:\n• Informations personnelles (nom, e-mail, téléphone)\n• Documents fiscaux et reçus\n• Données financières pour déclarations fiscales\n• Données d'utilisation de l'application\n\nToutes les données sont cryptées et stockées en toute sécurité.";
"privacy.data_use.title" = "3. Utilisation des Données";
"privacy.data_use.content" = "Nous utilisons vos données pour:\n• Préparer votre déclaration fiscale\n• Communiquer avec vous\n• Améliorer nos services\n• Respecter les obligations légales\n\nNous ne vendons jamais vos données à des tiers.";
"privacy.data_protection.title" = "4. Protection des Données";
"privacy.data_protection.content" = "Nous utilisons des mesures de sécurité standard:\n• Cryptage de bout en bout\n• Stockage cloud sécurisé\n• Audits de sécurité réguliers\n• Contrôle d'accès et authentification\n\nVos données sont protégées selon la loi suisse sur la protection des données.";
"privacy.rights.title" = "5. Vos Droits";
"privacy.rights.content" = "Vous avez le droit de:\n• Accéder à vos données\n• Corriger vos données\n• Supprimer vos données\n• Exporter vos données\n• Vous opposer au traitement des données\n\nContactez-nous pour exercer vos droits.";
"privacy.contact.title" = "6. Contact";
"privacy.contact.content" = "Pour toute question de confidentialité:\n\nTaxed GmbH\nAegertenstrasse 10\n2503 Bienne/Biel\nSuisse\n\nE-mail: info@taxed.ch\nTéléphone: +41 79 910 77 87";

// MARK: - Terms of Service
"terms.last_updated" = "Dernière Mise à Jour: Janvier 2025";
"terms.acceptance.title" = "1. Acceptation des Conditions";
"terms.acceptance.content" = "En utilisant l'application Taxed, vous acceptez ces conditions d'utilisation. Si vous n'êtes pas d'accord, veuillez ne pas utiliser l'application.";
"terms.services.title" = "2. Services";
"terms.services.content" = "Taxed GmbH fournit:\n• Gestion digitale de déclarations fiscales\n• Téléchargement et gestion de documents\n• Analyse de documents par IA\n• Support d'experts fiscaux\n• Conseil fiscal spécifique aux expatriés\n\nNous ne garantissons pas de remboursements fiscaux spécifiques.";
"terms.user_obligations.title" = "3. Obligations de l'Utilisateur";
"terms.user_obligations.content" = "Vous acceptez de:\n• Fournir des informations exactes\n• Garder votre compte sécurisé\n• Respecter la loi fiscale suisse\n• Ne pas abuser du service\n• Respecter les droits de propriété intellectuelle";
"terms.fees.title" = "4. Frais et Paiement";
"terms.fees.content" = "Les frais de service sont:\n• Clairement communiqués à l'avance\n• Basés sur la complexité du service\n• Payables avant soumission\n• Non remboursables après soumission\n\nLes prix sont sujets à changement avec préavis.";
"terms.liability.title" = "5. Limitation de Responsabilité";
"terms.liability.content" = "Taxed GmbH n'est pas responsable pour:\n• Erreurs dans les données fournies par l'utilisateur\n• Décisions des autorités fiscales\n• Dommages indirects ou consécutifs\n• Interruptions de service\n\nNotre responsabilité est limitée aux frais de service payés.";
"terms.termination.title" = "6. Résiliation";
"terms.termination.content" = "Nous pouvons résilier le service si:\n• Les conditions sont violées\n• Une activité frauduleuse est détectée\n• Le paiement n'est pas reçu\n\nVous pouvez annuler à tout moment avant soumission pour un remboursement complet.";
"terms.governing_law.title" = "7. Droit Applicable";
"terms.governing_law.content" = "Ces conditions sont régies par le droit suisse. La juridiction est Bienne/Biel, Suisse.";

