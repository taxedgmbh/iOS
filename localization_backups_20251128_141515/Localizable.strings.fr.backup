// MARK: - FAQ (New)
"faq.navigation_title" = "FAQ";
"faq.section.general" = "Général";
"faq.section.documents" = "Documents";
"faq.general.how_it_works.question" = "Comment fonctionne Taxed?";
"faq.general.how_it_works.answer" = "Taxed simplifie votre déclaration fiscale en 4 étapes simples: 1) Téléchargez vos documents, 2) Notre IA les analyse, 3) Nos experts vérifient tout, 4) Nous soumettons votre déclaration fiscale.";
"faq.general.is_secure.question" = "Est-ce sécurisé?";
"faq.general.is_secure.answer" = "Oui! Nous utilisons un cryptage de niveau bancaire et tous les serveurs sont situés en Suisse. Vos données ne quittent jamais le territoire suisse.";
"faq.documents.which_needed.question" = "Quels documents sont nécessaires?";
"faq.documents.which_needed.answer" = "En général, vous avez besoin de: certificats de salaire, déclarations bancaires, reçus pour déductions et autres documents pertinents pour vos revenus et dépenses.";
"faq.documents.how_upload.question" = "Comment télécharger des documents?";
"faq.documents.how_upload.answer" = "Utilisez simplement la fonction appareil photo pour prendre des photos de vos documents ou téléchargez des fichiers directement depuis votre appareil. Notre IA les traitera automatiquement.";

