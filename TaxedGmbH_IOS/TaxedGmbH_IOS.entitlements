<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Password AutoFill.

	  This is what lets iOS offer the password already saved for taxed.ch when
	  someone signs in here, and offer to save a strong generated one when they
	  sign up. Without it, the `.username` and `.password` content types on the
	  fields get generic keychain behaviour rather than this site's credential —
	  the difference between "tap the suggestion" and "go and look it up".

	  It only works if https://taxed.ch/.well-known/apple-app-site-association
	  serves {"webcredentials":{"apps":["8784L7RY33.com.taxed.app"]}} as
	  application/json, over HTTPS, with no redirect. That file is served by a
	  route handler in the taxed.ch repository.

	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:taxed.ch</string>
	</array>

	<!--
	  Sign in with Apple.

	  Not optional once Google sign-in is offered: App Store Review Guideline 4.8
	  requires an equivalent privacy-preserving option alongside any other
	  third-party login. The two ship together or neither does.

	  taxed.ch offers the same two providers, so an account created here signs in
	  on the website as well. That parity is the whole reason these are back —
	  added to the app alone, a Google account would carry no password and could
	  never be used on the site.
	-->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
