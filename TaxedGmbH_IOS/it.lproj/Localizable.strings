// MARK: - Privacy Policy
"privacy.last_updated" = "Ultimo Aggiornamento: Gennaio 2025";
"privacy.intro.title" = "1. Introduzione";
"privacy.intro.content" = "Taxed GmbH rispetta la tua privacy e si impegna a proteggere i tuoi dati personali. Questa informativa sulla privacy ti informa su come raccogliamo, utilizziamo e proteggiamo i tuoi dati.";
"privacy.data_collection.title" = "2. Raccolta Dati";
"privacy.data_collection.content" = "Raccogliamo i seguenti dati:\n• Informazioni personali (nome, e-mail, telefono)\n• Documenti fiscali e ricevute\n• Dati finanziari per dichiarazioni fiscali\n• Dati di utilizzo dell'app\n\nTutti i dati sono criptati e archiviati in modo sicuro.";
"privacy.data_use.title" = "3. Utilizzo dei Dati";
"privacy.data_use.content" = "Utilizziamo i tuoi dati per:\n• Preparare la tua dichiarazione fiscale\n• Comunicare con te\n• Migliorare i nostri servizi\n• Rispettare gli obblighi legali\n\nNon vendiamo mai i tuoi dati a terzi.";
"privacy.data_protection.title" = "4. Protezione dei Dati";
"privacy.data_protection.content" = "Utilizziamo misure di sicurezza standard del settore:\n• Crittografia end-to-end\n• Archiviazione cloud sicura\n• Audit di sicurezza regolari\n• Controllo accessi e autenticazione\n\nI tuoi dati sono protetti dalla legge svizzera sulla protezione dei dati.";
"privacy.rights.title" = "5. I Tuoi Diritti";
"privacy.rights.content" = "Hai il diritto di:\n• Accedere ai tuoi dati\n• Correggere i tuoi dati\n• Eliminare i tuoi dati\n• Esportare i tuoi dati\n• Opporti al trattamento dei dati\n\nContattaci per esercitare i tuoi diritti.";
"privacy.contact.title" = "6. Contatto";
"privacy.contact.content" = "Per domande sulla privacy:\n\nTaxed GmbH\nAegertenstrasse 10\n2503 Biel/Bienne\nSvizzera\n\nE-mail: info@taxed.ch\nTelefono: +41 79 910 77 87";

// MARK: - Terms of Service
"terms.last_updated" = "Ultimo Aggiornamento: Gennaio 2025";
"terms.acceptance.title" = "1. Accettazione dei Termini";
"terms.acceptance.content" = "Utilizzando l'app Taxed, accetti questi termini di servizio. Se non sei d'accordo, non utilizzare l'app.";
"terms.services.title" = "2. Servizi";
"terms.services.content" = "Taxed GmbH fornisce:\n• Gestione digitale dichiarazioni fiscali\n• Caricamento e gestione documenti\n• Analisi documenti con IA\n• Supporto da esperti fiscali\n• Consulenza fiscale specifica per expat\n\nNon garantiamo rimborsi fiscali specifici.";
"terms.user_obligations.title" = "3. Obblighi dell'Utente";
"terms.user_obligations.content" = "Accetti di:\n• Fornire informazioni accurate\n• Mantenere sicuro il tuo account\n• Rispettare la legge fiscale svizzera\n• Non abusare del servizio\n• Rispettare i diritti di proprietà intellettuale";
"terms.fees.title" = "4. Tariffe e Pagamento";
