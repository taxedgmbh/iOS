// Erste Schritte
"help.getting_started" = "Erste Schritte";
"help.getting_started.desc" = "So starten Sie mit Taxed";
"help.getting_started.content" = "Willkommen bei Taxed!\n\n1. Erstellen Sie Ihr Konto mit E-Mail oder Apple ID\n2. Vervollständigen Sie Ihr Profil\n3. Laden Sie Ihre Steuerdokumente hoch\n4. Unsere KI analysiert und kategorisiert sie\n5. Überprüfen und reichen Sie Ihre Steuererklärung ein\n\nBrauchen Sie Hilfe? Kontaktieren Sie uns: info@taxed.ch";

// Dokumente hochladen
"help.how_upload" = "Wie lade ich Dokumente hoch?";
"help.how_upload.desc" = "Schritt-für-Schritt Anleitung";
"help.how_upload.content" = "Dokumente hochladen ist einfach:\n\n1. Öffnen Sie den Dokumente-Tab\n2. Tippen Sie auf '+'\n3. Wählen Sie Kamera oder Galerie\n4. Fotografieren oder wählen Sie ein Bild\n5. Bestätigen Sie den Upload\n\nUnsere KI:\n• Analysiert das Dokument\n• Kategorisiert es automatisch\n• Extrahiert wichtige Informationen\n• Validiert die Daten\n\nSupport: info@taxed.ch";

// Expat-Steuern
"help.expat_taxes" = "Wie funktionieren Steuern für Expats?";
"help.expat_taxes.desc" = "Spezielle Anforderungen für Expats";
"help.expat_taxes.content" = "Als Expat in der Schweiz müssen Sie:\n\n• Alle Schweizer Einkommen deklarieren\n• Ausländisches Einkommen und Vermögen angeben\n• Doppelbesteuerungsabkommen nutzen\n• Ausländische Steuer-Bescheinigungen einreichen\n• Pensionskasse (Säule 2/3) dokumentieren\n• Aufenthaltsbewilligungen vorlegen\n\nWir unterstützen Sie mit:\n• Automatische Abkommensanträge\n• Ausländische Einkommensberechnung\n• Mehrsprachige Beratung\n• Expertenberatung\n\nKontakt: info@taxed.ch\nTelefon: +41 79 910 77 87";

// Steuerfristen
"help.deadlines" = "Welche Steuerfristen gibt es?";
"help.deadlines.desc" = "Wichtige Termine und Fristen";
"help.deadlines.content" = "Schweizer Steuerkalender:\n\n• 31. März: Reguläre Frist\n• Mai-Juni: Verlängerte Frist (mit Antrag)\n• September: Maximale Verlängerung (mit Berater)\n\nExpat-Vorteile:\n• Automatische Fristverlängerungen\n• Zusätzliche Zeit für ausländische Dokumente\n• Professionelle Unterstützung inklusive\n\nFristverlängerung? Kontakt: info@taxed.ch";

// Datenschutz
"help.account_privacy" = "Wie werden meine Daten geschützt?";
"help.account_privacy.desc" = "Sicherheits- und Datenschutzmaßnahmen";
"help.account_privacy.content" = "Ihre Datensicherheit hat Priorität:\n\n• End-to-End-Verschlüsselung\n• Schweizer Datenschutzgesetz-Konformität\n• Sichere Cloud-Speicherung (AWS)\n• Regelmäßige Sicherheitsaudits\n• Keine Weitergabe an Dritte\n\nSie können:\n• Ihre Daten jederzeit exportieren\n• Ihr Konto löschen\n• Datenkorrekturen anfordern\n\nDatenschutz-Fragen: info@taxed.ch";

// Preise
"help.pricing" = "Was kostet der Service?";
"help.pricing.desc" = "Transparente Preisinformationen";
"help.pricing.content" = "Unsere Preise sind einfach und transparent:\n\n• Basis-Steuererklärung: CHF 99\n• Expat-Services: CHF 149\n• Komplexe Fälle: CHF 199\n• Expertenberatung: CHF 50/Stunde\n\nIn allen Paketen enthalten:\n• Unbegrenzte Dokument-Uploads\n• KI-Analyse\n• E-Mail-Support\n• Sichere Speicherung\n\nFragen: info@taxed.ch";

// Support kontaktieren
