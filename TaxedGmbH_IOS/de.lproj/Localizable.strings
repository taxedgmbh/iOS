// MARK: - Privacy Policy
"privacy.last_updated" = "Letzte Aktualisierung: Januar 2025";
"privacy.intro.title" = "1. Einleitung";
"privacy.intro.content" = "Taxed GmbH respektiert Ihre Privatsphäre und verpflichtet sich zum Schutz Ihrer personenbezogenen Daten. Diese Datenschutzerklärung informiert Sie darüber, wie wir Ihre Daten erheben, verwenden und schützen.";
"privacy.data_collection.title" = "2. Datenerhebung";
"privacy.data_collection.content" = "Wir erheben folgende Daten:\n• Persönliche Informationen (Name, E-Mail, Telefon)\n• Steuerdokumente und Belege\n• Finanzdaten für Steuererklärungen\n• Nutzungsdaten der App\n\nAlle Daten werden verschlüsselt und sicher gespeichert.";
"privacy.data_use.title" = "3. Datenverwendung";
"privacy.data_use.content" = "Ihre Daten werden verwendet für:\n• Erstellung Ihrer Steuererklärung\n• Kommunikation mit Steuerexperten\n• Verbesserung unserer Dienstleistungen\n• Rechtliche Verpflichtungen\n\nWir verkaufen Ihre Daten niemals an Dritte.";
"privacy.data_protection.title" = "4. Datensicherheit";
"privacy.data_protection.content" = "Wir verwenden branchenübliche Sicherheitsmaßnahmen:\n• End-to-End-Verschlüsselung\n• Sichere Cloud-Speicherung\n• Regelmäßige Sicherheitsaudits\n• Zugriffskontrolle und Authentifizierung\n\nIhre Daten sind nach Schweizer Datenschutzgesetz geschützt.";
"privacy.your_rights.title" = "5. Ihre Rechte";
"privacy.your_rights.content" = "Sie haben das Recht auf:\n• Auskunft über Ihre gespeicherten Daten\n• Berichtigung falscher Daten\n• Löschung Ihrer Daten\n• Datenübertragbarkeit\n• Widerspruch gegen Datenverarbeitung\n\nKontaktieren Sie uns unter info@taxed.ch.";
"privacy.contact.title" = "6. Kontakt";
"privacy.contact.content" = "Bei Fragen zum Datenschutz:\n\nTaxed GmbH\nAegertenstrasse 10\n2503 Biel/Bienne\nSchweiz\n\nE-Mail: info@taxed.ch\nTelefon: +41 79 910 77 87";

