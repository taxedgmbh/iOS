// MARK: - Privacy Policy (Data Storage)
"privacy.data_storage_auth.title" = "Speicherung von Authentifizierungsdaten";
"privacy.data_storage_auth.content" = "Benutzerauthentifizierungsinformationen (E-Mail-Adressen, verschlüsselte Passwörter, Benutzer-IDs) werden von Firebase Authentication (Google Cloud Platform) verarbeitet und in den Vereinigten Staaten gespeichert. Für transatlantische Datentransfers unterhält Google Standardvertragsklauseln (SCCs) und hält sich an das EU-US Data Privacy Framework und das Swiss-US Data Privacy Framework, um die Einhaltung der DSGVO und des Schweizer DSG zu gewährleisten.";

"privacy.data_storage_app.title" = "Speicherung von Anwendungsdaten";
"privacy.data_storage_app.content" = "Alle anderen personenbezogenen Daten, einschließlich Steuerunterlagen, Nachrichten, Chat-Verlauf und Anwendungsdaten, werden ausschließlich in der Schweiz mit Google Cloud Firestore (Datenbank-ID: taxedgmbh) im Raum Zürich (europe-west6) gespeichert. Diese Daten werden im Ruhezustand mit AES-256-Verschlüsselung und bei der Übertragung mit TLS 1.3-Protokoll verschlüsselt. Ihre Anwendungsdaten verlassen niemals die Schweizer oder EU-Rechtsordnung.";

"privacy.data_processing.title" = "Datenverarbeitung";
"privacy.data_processing.content" = "Wir verwenden Firebase-Dienste (Google Cloud Platform) als unseren Datenverarbeiter. Firebase ist nach ISO 27001, ISO 27017, ISO 27018 und SOC 2/3-Standards zertifiziert. Datenverarbeitungsvereinbarungen (DPA) sind vorhanden, die die Einhaltung der DSGVO und des Schweizer DSG gewährleisten. Die Verarbeitung von Anwendungsdaten erfolgt ausschließlich innerhalb der EU/Schweiz-Region.";

"privacy.data_transfers.title" = "Internationale Datenübertragungen";
"privacy.data_transfers.content" = "Authentifizierungsdaten (E-Mails, Passwörter) können über Firebase Authentication in die Vereinigten Staaten übertragen werden. Diese Übertragungen sind durch Standardvertragsklauseln (SCCs) geschützt, die von der Europäischen Kommission und dem Eidgenössischen Datenschutz- und Öffentlichkeitsbeauftragten (EDÖB) genehmigt wurden. Alle anderen personenbezogenen Daten verbleiben in der Schweiz (Zürich, europe-west6) und werden nicht außerhalb der Schweizer oder EU-Rechtsordnung übertragen.";

