//
//  ClaimsService.swift
//  TaxedGmbH_IOS
//
//  Manages custom claims for workspace membership security.
//  Calls Firebase Cloud Functions to update JWT token claims.
//

import Foundation
import FirebaseFunctions
import FirebaseAuth

class ClaimsService {
    static let shared = ClaimsService()

    private let functions = Functions.functions()

    private init() {}

    /// Update user's workspace membership claims
    ///
    /// This should be called:
    /// - After successful login/signup
    /// - When user joins/creates a workspace
    /// - When user leaves a workspace
    ///
    /// The Cloud Function will:
    /// 1. Query Firestore for user's workspace memberships
    /// 2. Update the user's JWT custom claims
    /// 3. Return the count of workspaces
    ///
    /// After calling this, the user needs to get a new ID token for the claims to take effect.
    /// Firebase automatically refreshes tokens hourly, but we can force a refresh.
    ///
    /// - Returns: Number of workspaces the user is a member of
    /// - Throws: Error if the Cloud Function call fails
    @MainActor
    func updateWorkspaceClaims() async throws -> Int {
        print("🔐 ClaimsService: Requesting workspace claims update...")

        // Call the Cloud Function
        let callable = functions.httpsCallable("updateWorkspaceClaims")

        do {
            let result = try await callable.call()

            guard let data = result.data as? [String: Any],
                  let success = data["success"] as? Bool,
                  success == true else {
                throw ClaimsError.invalidResponse
            }

            let workspaceCount = data["workspaceCount"] as? Int ?? 0
            let message = data["message"] as? String ?? "Claims updated"

            print("✅ ClaimsService: \(message)")
            print("   Workspaces: \(workspaceCount)")

            // Force refresh the user's ID token to get the new claims
            // This is important because Storage Rules check the JWT token
            if let currentUser = Auth.auth().currentUser {
                _ = try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<String, Error>) in
                    currentUser.getIDTokenForcingRefresh(true) { token, error in
                        if let error = error {
                            continuation.resume(throwing: error)
                        } else if let token = token {
                            continuation.resume(returning: token)
                        } else {
                            continuation.resume(throwing: ClaimsError.invalidResponse)
                        }
                    }
                }
                print("✅ ClaimsService: ID token refreshed with new claims")
            }

            return workspaceCount

        } catch {
            print("❌ ClaimsService: Failed to update claims: \(error.localizedDescription)")
            throw ClaimsError.functionCallFailed(error.localizedDescription)
        }
    }

    /// Get user's current custom claims (for debugging)
    ///
    /// Useful for verifying that claims are set correctly.
    ///
    /// - Returns: Dictionary of custom claims
    func getUserClaims() async throws -> [String: Any] {
        print("🔍 ClaimsService: Getting user claims...")

        let callable = functions.httpsCallable("getUserClaims")

        do {
            let result = try await callable.call()

            guard let data = result.data as? [String: Any],
                  let claims = data["claims"] as? [String: Any] else {
                throw ClaimsError.invalidResponse
            }

            print("✅ ClaimsService: Claims retrieved")
            print("   Claims: \(claims)")

            return claims

        } catch {
            print("❌ ClaimsService: Failed to get claims: \(error.localizedDescription)")
            throw ClaimsError.functionCallFailed(error.localizedDescription)
        }
    }

    /// Verify that user has access to a specific workspace
    ///
    /// Checks the user's ID token for workspace membership claim.
    ///
    /// - Parameter workspaceId: The workspace ID to check
    /// - Returns: True if user has access, false otherwise
    func verifyWorkspaceAccess(workspaceId: String) async -> Bool {
        guard let currentUser = Auth.auth().currentUser else {
            print("⚠️ ClaimsService: No authenticated user")
            return false
        }

        do {
            // Get the ID token result which includes custom claims
            let tokenResult = try await currentUser.getIDTokenResult(forcingRefresh: false)

            // Check if workspaces claim exists and contains the workspace
            if let workspaces = tokenResult.claims["workspaces"] as? [String: Bool],
               workspaces[workspaceId] == true {
                print("✅ ClaimsService: User has access to workspace \(workspaceId)")
                return true
            } else {
                print("⚠️ ClaimsService: User does NOT have access to workspace \(workspaceId)")
                print("   Available workspaces: \(tokenResult.claims["workspaces"] ?? "none")")
                return false
            }

        } catch {
            print("❌ ClaimsService: Error verifying workspace access: \(error.localizedDescription)")
            return false
        }
    }
}

// MARK: - Errors

enum ClaimsError: LocalizedError {
    case invalidResponse
    case functionCallFailed(String)
    case notAuthenticated

    var errorDescription: String? {
        switch self {
        case .invalidResponse:
            return "Invalid response from Cloud Function"
        case .functionCallFailed(let message):
            return "Cloud Function call failed: \(message)"
        case .notAuthenticated:
            return "User must be authenticated"
        }
    }
}
