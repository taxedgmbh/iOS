//
//  WorkspaceManager.swift
//  TaxedGmbH_IOS
//
//  Service for managing collaborative workspaces
//  Enables spouses, partners, or family members to share tax document access
//

import Foundation
import FirebaseFirestore
import Combine

@MainActor
class WorkspaceManager: ObservableObject {
    static let shared = WorkspaceManager()

    private let firestore: Firestore

    // Published state
    @Published var userWorkspaces: [Workspace] = []
    @Published var activeWorkspace: Workspace?
    @Published var pendingInvitations: [WorkspaceInvitation] = []
    @Published var isLoading: Bool = false
    @Published var error: String?

    private init() {
        // Initialize Firestore with named database support
        if let databaseId = AppConstants.Firebase.databaseId {
            print("🔧 WorkspaceManager using named database: \(databaseId)")
            self.firestore = Firestore.firestore(database: databaseId)
        } else {
            print("🔧 WorkspaceManager using default database")
            self.firestore = Firestore.firestore()
        }
    }

    // MARK: - Create Workspace

    /// Create a new workspace with the current user as owner
    func createWorkspace(
        name: String,
        type: WorkspaceType = .personal,
        taxYear: Int,
        owner: User,
        description: String? = nil
    ) async throws -> Workspace {
        guard let ownerId = owner.id else {
            throw NSError(domain: "WorkspaceManager", code: 1, userInfo: [NSLocalizedDescriptionKey: "Owner must have a valid ID"])
        }

        isLoading = true
        error = nil
        defer { isLoading = false }

        // Create owner as first member
        let ownerMember = WorkspaceMember(
            userId: ownerId,
            email: owner.email,
            name: owner.name,
            role: .owner,
            joinedAt: Date(),
            invitedBy: nil
        )

        // Create workspace
        var workspace = Workspace(
            name: name,
            type: type,
            ownerId: ownerId,
            members: [ownerMember],
            taxYear: taxYear,
            description: description
        )

        // Save to Firestore
        let docRef = try await firestore
            .collection(AppConstants.Firebase.Collections.workspaces)
            .addDocument(data: workspace.toDictionary())

        workspace.id = docRef.documentID

        // Update user's workspace list and ALWAYS set newly created workspace as active in Firestore
        try await addWorkspaceToUser(userId: ownerId, workspaceId: docRef.documentID, setAsActive: true)

        // Add to local array
        userWorkspaces.append(workspace)

        // Set newly created workspace as active in memory
        activeWorkspace = workspace
        print("✅ Set newly created workspace as active (both in memory and Firestore): \(name)")

        print("✅ Created workspace: \(name) with ID: \(docRef.documentID)")

        // Update workspace membership claims for immediate storage access
        // Note: Firestore trigger will also update claims, but calling here provides immediate feedback
        Task {
            do {
                _ = try await ClaimsService.shared.updateWorkspaceClaims()
                print("🔐 Workspace claims updated after creating workspace")
            } catch {
                print("⚠️ Failed to update workspace claims: \(error.localizedDescription)")
                // Don't fail workspace creation if claims update fails
            }
        }

        return workspace
    }

    // MARK: - Invite Members

    /// Invite a user to join workspace by email
    func inviteMember(
        to workspace: Workspace,
        email: String,
        role: WorkspaceMemberRole = .member,
        invitedBy: User
    ) async throws -> WorkspaceInvitation {
        guard let workspaceId = workspace.id else {
            throw NSError(domain: "WorkspaceManager", code: 2, userInfo: [NSLocalizedDescriptionKey: "Workspace must have a valid ID"])
        }

        guard let inviterId = invitedBy.id else {
            throw NSError(domain: "WorkspaceManager", code: 3, userInfo: [NSLocalizedDescriptionKey: "Inviter must have a valid ID"])
        }

        // Check if inviter has admin access
        guard workspace.hasAdminAccess(userId: inviterId) else {
            throw NSError(domain: "WorkspaceManager", code: 4, userInfo: [NSLocalizedDescriptionKey: "Only owners and admins can invite members"])
        }

        isLoading = true
        error = nil
        defer { isLoading = false }

        // Check if email is already a member
        if workspace.members.contains(where: { $0.email == email }) {
            throw NSError(domain: "WorkspaceManager", code: 5, userInfo: [NSLocalizedDescriptionKey: "User is already a member"])
        }

        // Create invitation
        var invitation = WorkspaceInvitation(
            workspaceId: workspaceId,
            workspaceName: workspace.name,
            invitedEmail: email,
            invitedByUserId: inviterId,
            invitedByName: invitedBy.name,
            role: role
        )

        // Save invitation to Firestore
        let docRef = try await firestore
            .collection(AppConstants.Firebase.Collections.workspaceInvitations)
            .addDocument(data: invitation.toDictionary())

        invitation.id = docRef.documentID

        print("✅ Sent invitation to \(email) for workspace: \(workspace.name)")

        // TODO: Send email notification to invitee

        return invitation
    }

    // MARK: - Accept/Decline Invitations

    /// Accept a workspace invitation
    func acceptInvitation(_ invitation: WorkspaceInvitation, user: User) async throws {
        guard let invitationId = invitation.id,
              let userId = user.id else {
            throw NSError(domain: "WorkspaceManager", code: 6, userInfo: [NSLocalizedDescriptionKey: "Invalid invitation or user ID"])
        }

        // Check if invitation is expired
        if invitation.isExpired {
            throw NSError(domain: "WorkspaceManager", code: 7, userInfo: [NSLocalizedDescriptionKey: "Invitation has expired"])
        }

        // Check if email matches
        if invitation.invitedEmail.lowercased() != user.email.lowercased() {
            throw NSError(domain: "WorkspaceManager", code: 8, userInfo: [NSLocalizedDescriptionKey: "Invitation was sent to a different email"])
        }

        isLoading = true
        error = nil
        defer { isLoading = false }

        // Create new member
        let newMember = WorkspaceMember(
            userId: userId,
            email: user.email,
            name: user.name,
            role: invitation.role,
            joinedAt: Date(),
            invitedBy: invitation.invitedByUserId
        )

        // Add member to workspace
        try await firestore
            .collection(AppConstants.Firebase.Collections.workspaces)
            .document(invitation.workspaceId)
            .updateData([
                "members": FieldValue.arrayUnion([newMember.toDictionary()]),
                "memberIds": FieldValue.arrayUnion([userId]),
                "updatedAt": Timestamp(date: Date())
            ])

        // Update invitation status
        try await firestore
            .collection(AppConstants.Firebase.Collections.workspaceInvitations)
            .document(invitationId)
            .updateData([
                "status": WorkspaceInvitation.InvitationStatus.accepted.rawValue
            ])

        // Add workspace to user's list
        try await addWorkspaceToUser(userId: userId, workspaceId: invitation.workspaceId)

        // Reload workspaces
        try await loadUserWorkspaces(for: userId)

        print("✅ Accepted invitation to workspace: \(invitation.workspaceName)")

        // Update workspace membership claims for immediate storage access
        // Note: Firestore trigger will also update claims, but calling here provides immediate feedback
        Task {
            do {
                _ = try await ClaimsService.shared.updateWorkspaceClaims()
                print("🔐 Workspace claims updated after accepting invitation")
            } catch {
                print("⚠️ Failed to update workspace claims: \(error.localizedDescription)")
                // Don't fail invitation acceptance if claims update fails
            }
        }
    }

    /// Decline a workspace invitation
    func declineInvitation(_ invitation: WorkspaceInvitation) async throws {
        guard let invitationId = invitation.id else {
            throw NSError(domain: "WorkspaceManager", code: 9, userInfo: [NSLocalizedDescriptionKey: "Invalid invitation ID"])
        }

        isLoading = true
        error = nil
        defer { isLoading = false }

        try await firestore
            .collection(AppConstants.Firebase.Collections.workspaceInvitations)
            .document(invitationId)
            .updateData([
                "status": WorkspaceInvitation.InvitationStatus.declined.rawValue
            ])

        // Remove from local list
        pendingInvitations.removeAll { $0.id == invitationId }

        print("✅ Declined invitation to workspace: \(invitation.workspaceName)")
    }

    // MARK: - Load Workspaces

    /// Get a single workspace by ID
    func getWorkspace(workspaceId: String) async throws -> Workspace {
        let snapshot = try await firestore
            .collection(AppConstants.Firebase.Collections.workspaces)
            .document(workspaceId)
            .getDocument()

        guard snapshot.exists, let data = snapshot.data() else {
            throw NSError(domain: "WorkspaceManager", code: 14, userInfo: [
                NSLocalizedDescriptionKey: "Workspace not found"
            ])
        }

        var dict = data
        dict["id"] = snapshot.documentID

        guard let workspace = Workspace.fromDictionary(dict) else {
            throw NSError(domain: "WorkspaceManager", code: 15, userInfo: [
                NSLocalizedDescriptionKey: "Failed to parse workspace data"
            ])
        }

        return workspace
    }

    /// Load all workspaces for a user
    func loadUserWorkspaces(for userId: String, setActiveFromUser: Bool = true) async throws {
        isLoading = true
        error = nil
        defer { isLoading = false }

        print("🔍 =============== WORKSPACE LOADING DEBUG ===============")
        print("   Loading workspaces for user ID: \(userId)")

        // Query workspaces where user ID is in memberIds array
        let snapshot = try await firestore
            .collection(AppConstants.Firebase.Collections.workspaces)
            .whereField("memberIds", arrayContains: userId)
            .getDocuments()

        userWorkspaces = snapshot.documents.compactMap { doc in
            var dict = doc.data()
            dict["id"] = doc.documentID
            return Workspace.fromDictionary(dict)
        }

        print("✅ Loaded \(userWorkspaces.count) workspaces for user")

        // Debug: Print detailed info about each workspace
        for (index, workspace) in userWorkspaces.enumerated() {
            print("   📁 Workspace #\(index + 1):")
            print("      ID: \(workspace.id ?? "nil")")
            print("      Name: \(workspace.name)")
            print("      Owner ID: \(workspace.ownerId)")
            print("      Member IDs: \(workspace.memberIds)")
            print("      Member Count: \(workspace.members.count)")
            for (mIndex, member) in workspace.members.enumerated() {
                print("         Member #\(mIndex + 1): \(member.userId) (\(member.email)) - \(member.role.rawValue)")
            }
            print("      User '\(userId)' is member: \(workspace.isMember(userId: userId) ? "YES ✅" : "NO ❌")")
        }
        print("=======================================================")

        // If requested, set active workspace from user's preference
        if setActiveFromUser {
            // Get user's activeWorkspaceId from Firestore
            let userDoc = try await firestore
                .collection(AppConstants.Firebase.Collections.users)
                .document(userId)
                .getDocument()

            if let userData = userDoc.data(),
               let activeWorkspaceId = userData["activeWorkspaceId"] as? String {
                // Find and set the user's preferred active workspace
                if let preferredWorkspace = userWorkspaces.first(where: { $0.id == activeWorkspaceId }) {
                    activeWorkspace = preferredWorkspace
                    print("✅ Set active workspace from user preference: \(preferredWorkspace.name)")
                } else {
                    // Preferred workspace not found in loaded workspaces, use first available
                    activeWorkspace = userWorkspaces.first
                    print("⚠️ Preferred workspace not found, using first available")
                }
            } else {
                // No active workspace preference, use first available
                activeWorkspace = userWorkspaces.first
                print("ℹ️ No active workspace preference, using first available")
            }
        } else if activeWorkspace == nil, let first = userWorkspaces.first {
            // Fallback: Set active workspace if none exists
            activeWorkspace = first
        }
    }

    /// Load pending invitations for user's email
    func loadPendingInvitations(for email: String) async throws {
        isLoading = true
        error = nil
        defer { isLoading = false }

        let snapshot = try await firestore
            .collection(AppConstants.Firebase.Collections.workspaceInvitations)
            .whereField("invitedEmail", isEqualTo: email.lowercased())
            .whereField("status", isEqualTo: WorkspaceInvitation.InvitationStatus.pending.rawValue)
            .getDocuments()

        pendingInvitations = snapshot.documents.compactMap { doc in
            var dict = doc.data()
            dict["id"] = doc.documentID
            return WorkspaceInvitation.fromDictionary(dict)
        }.filter { !$0.isExpired }  // Filter out expired invitations

        print("✅ Loaded \(pendingInvitations.count) pending invitations")
    }

    // MARK: - Remove Members

    /// Remove a member from workspace (admin/owner only)
    func removeMember(userId: String, from workspace: Workspace, removedBy: User) async throws {
        guard let workspaceId = workspace.id,
              let removerId = removedBy.id else {
            throw NSError(domain: "WorkspaceManager", code: 10, userInfo: [NSLocalizedDescriptionKey: "Invalid workspace or remover ID"])
        }

        // Check if remover has admin access
        guard workspace.hasAdminAccess(userId: removerId) else {
            throw NSError(domain: "WorkspaceManager", code: 11, userInfo: [NSLocalizedDescriptionKey: "Only owners and admins can remove members"])
        }

        // Cannot remove owner
        if userId == workspace.ownerId {
            throw NSError(domain: "WorkspaceManager", code: 12, userInfo: [NSLocalizedDescriptionKey: "Cannot remove workspace owner"])
        }

        isLoading = true
        error = nil
        defer { isLoading = false }

        // Get member to remove
        guard let memberToRemove = workspace.getMember(userId: userId) else {
            throw NSError(domain: "WorkspaceManager", code: 13, userInfo: [NSLocalizedDescriptionKey: "User is not a member"])
        }

        // Remove member from workspace
        try await firestore
            .collection(AppConstants.Firebase.Collections.workspaces)
            .document(workspaceId)
            .updateData([
                "members": FieldValue.arrayRemove([memberToRemove.toDictionary()]),
                "memberIds": FieldValue.arrayRemove([userId]),
                "updatedAt": Timestamp(date: Date())
            ])

        // Remove workspace from user's list
        try await firestore
            .collection(AppConstants.Firebase.Collections.users)
            .document(userId)
            .updateData([
                "workspaceIds": FieldValue.arrayRemove([workspaceId])
            ])

        print("✅ Removed member \(userId) from workspace: \(workspace.name)")
    }

    // MARK: - Helper Methods

    private func addWorkspaceToUser(userId: String, workspaceId: String, setAsActive: Bool = false) async throws {
        var updateData: [String: Any] = [
            "workspaceIds": FieldValue.arrayUnion([workspaceId]),
            "updatedAt": Timestamp(date: Date())
        ]

        // If explicitly requested to set as active, always do it
        if setAsActive {
            updateData["activeWorkspaceId"] = workspaceId
            print("✅ Setting \(workspaceId) as active workspace")
        } else {
            // Otherwise, only set as active if user doesn't have one yet
            let userDoc = try await firestore
                .collection(AppConstants.Firebase.Collections.users)
                .document(userId)
                .getDocument()

            if let userData = userDoc.data(),
               userData["activeWorkspaceId"] == nil {
                updateData["activeWorkspaceId"] = workspaceId
                print("✅ Setting \(workspaceId) as active workspace (first workspace)")
            } else {
                print("ℹ️ User already has an active workspace, not overriding")
            }
        }

        try await firestore
            .collection(AppConstants.Firebase.Collections.users)
            .document(userId)
            .updateData(updateData)
    }

    // MARK: - Convenience Properties and Methods

    /// Convenience property for accessing the current workspace (alias for activeWorkspace)
    var currentWorkspace: Workspace? {
        return activeWorkspace
    }

    /// Load the current workspace for the active user
    func loadCurrentWorkspace(userId: String? = nil) async {
        // Use provided userId or try to get from first workspace
        let userIdToLoad: String?
        if let userId = userId {
            userIdToLoad = userId
        } else if let firstWorkspace = userWorkspaces.first {
            // If we already have workspaces, use the owner/member ID
            userIdToLoad = firstWorkspace.ownerId
        } else {
            print("⚠️ Cannot load current workspace: No user ID provided")
            return
        }

        guard let uid = userIdToLoad else { return }

        do {
            try await loadUserWorkspaces(for: uid, setActiveFromUser: true)
        } catch {
            print("❌ Error loading current workspace: \(error)")
            self.error = error.localizedDescription
        }
    }

    /// Set a workspace as the active workspace for a user
    /// This updates both the in-memory state and persists to Firestore
    func setActiveWorkspace(_ workspace: Workspace, for userId: String) async throws {
        guard let workspaceId = workspace.id else {
            throw NSError(domain: "WorkspaceManager", code: 30, userInfo: [
                NSLocalizedDescriptionKey: "Workspace must have a valid ID"
            ])
        }

        // Verify user is a member of this workspace
        guard workspace.isMember(userId: userId) else {
            throw NSError(domain: "WorkspaceManager", code: 31, userInfo: [
                NSLocalizedDescriptionKey: "User is not a member of this workspace"
            ])
        }

        // Update in-memory state
        activeWorkspace = workspace

        // Persist to Firestore
        try await firestore
            .collection(AppConstants.Firebase.Collections.users)
            .document(userId)
            .updateData([
                "activeWorkspaceId": workspaceId,
                "updatedAt": Timestamp(date: Date())
            ])

        print("✅ Set active workspace: \(workspace.name) for user: \(userId)")
    }

    /// Update an existing workspace
    func updateWorkspace(_ workspace: Workspace) async throws {
        guard let workspaceId = workspace.id else {
            throw NSError(domain: "WorkspaceManager", code: 20, userInfo: [NSLocalizedDescriptionKey: "Workspace must have a valid ID"])
        }

        isLoading = true
        error = nil
        defer { isLoading = false }

        // Update workspace in Firestore
        try await firestore
            .collection(AppConstants.Firebase.Collections.workspaces)
            .document(workspaceId)
            .setData(workspace.toDictionary(), merge: true)

        // Update local state
        if let index = userWorkspaces.firstIndex(where: { $0.id == workspaceId }) {
            userWorkspaces[index] = workspace
        }

        // Update active workspace if it's the one being updated
        if activeWorkspace?.id == workspaceId {
            activeWorkspace = workspace
        }

        print("✅ Updated workspace: \(workspace.name)")
    }
}
