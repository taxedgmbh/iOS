"privacy.last_updated" = "Last Updated: January 2025";
"privacy.intro.title" = "1. Introduction";
"privacy.intro.content" = "Taxed GmbH respects your privacy and is committed to protecting your personal data. This privacy policy informs you about how we collect, use, and protect your data.";
"privacy.data_collection.title" = "2. Data Collection";
"privacy.data_collection.content" = "We collect the following data:\n• Personal information (name, email, phone)\n• Tax documents and receipts\n• Financial data for tax returns\n• App usage data\n\nAll data is encrypted and stored securely.";
"privacy.data_use.title" = "3. Data Use";
"privacy.data_use.content" = "We use your data to:\n• Prepare your tax return\n• Communicate with you\n• Improve our services\n• Comply with legal obligations\n\nWe never sell your data to third parties.";
"privacy.data_protection.title" = "4. Data Protection";
"privacy.data_protection.content" = "We use industry-standard security measures:\n• End-to-end encryption\n• Secure cloud storage\n• Regular security audits\n• Access control and authentication\n\nYour data is protected under Swiss data protection law.";
"privacy.rights.title" = "5. Your Rights";
"privacy.rights.content" = "You have the right to:\n• Access your data\n• Correct your data\n• Delete your data\n• Export your data\n• Object to data processing\n\nContact us to exercise your rights.";
