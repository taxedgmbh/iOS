// MARK: - Privacy Policy (Data Storage)
"privacy.data_storage_auth.title" = "Authentication Data Storage";
"privacy.data_storage_auth.content" = "User authentication information (email addresses, encrypted passwords, user IDs) is processed by Firebase Authentication (Google Cloud Platform) and stored in the United States. For transatlantic data transfers, Google maintains Standard Contractual Clauses (SCCs) and adheres to the EU-US Data Privacy Framework and Swiss-US Data Privacy Framework, ensuring compliance with GDPR and Swiss FADP requirements.";

"privacy.data_storage_app.title" = "Application Data Storage";
"privacy.data_storage_app.content" = "All other personal data, including tax documents, messages, chat history, and application data, is stored exclusively in Switzerland using Google Cloud Firestore (Database ID: taxedgmbh) located in the Zurich region (europe-west6). This data is encrypted at rest using AES-256 encryption and in transit using TLS 1.3 protocol. Your application data never leaves Swiss or EU jurisdiction.";

"privacy.data_processing.title" = "Data Processing";
"privacy.data_processing.content" = "We use Firebase services (Google Cloud Platform) as our data processor. Firebase is certified under ISO 27001, ISO 27017, ISO 27018, and SOC 2/3 standards. Data Processing Agreements (DPA) are in place ensuring GDPR and Swiss FADP compliance. Application data processing occurs exclusively within the EU/Switzerland region.";

"privacy.data_transfers.title" = "International Data Transfers";
"privacy.data_transfers.content" = "Authentication data (emails, passwords) may be transferred to the United States via Firebase Authentication. These transfers are protected by Standard Contractual Clauses (SCCs) approved by the European Commission and the Swiss Federal Data Protection and Information Commissioner (FDPIC). All other personal data remains in Switzerland (Zurich, europe-west6) and is not transferred outside of Swiss or EU jurisdiction.";

