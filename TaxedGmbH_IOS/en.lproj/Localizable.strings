// Getting Started
"help.getting_started" = "Getting Started";
"help.getting_started.desc" = "First steps with Taxed";
"help.getting_started.content" = "Welcome to Taxed!\n\n1. Create your account with email or Apple ID\n2. Complete your profile information\n3. Start uploading your tax documents\n4. Our AI will analyze and categorize them\n5. Review and submit your tax return\n\nNeed help? Contact us at info@taxed.ch";

// Document Upload
"help.how_upload" = "How do I upload documents?";
"help.how_upload.desc" = "Step-by-step upload guide";
"help.how_upload.content" = "Uploading documents is easy:\n\n1. Open the Documents tab\n2. Tap the '+' button\n3. Choose Camera or Gallery\n4. Take a photo or select an image\n5. Confirm the upload\n\nOur AI automatically:\n• Analyzes the document\n• Categorizes it correctly\n• Extracts key information\n• Validates the data\n\nSupport: info@taxed.ch";

// Expat Taxes
"help.expat_taxes" = "How do expat taxes work in Switzerland?";
"help.expat_taxes.desc" = "Special requirements for expats";
"help.expat_taxes.content" = "As an expat in Switzerland, you must:\n\n• Declare all Swiss income\n• Report foreign income and assets\n• Use double taxation agreements\n• Submit foreign tax certificates\n• Document pension funds (Pillar 2/3)\n• Provide residence permits\n\nWe support you with:\n• Automatic treaty applications\n• Foreign income calculations\n• Multilingual assistance\n• Expert consultation\n\nContact: info@taxed.ch\nPhone: +41 79 910 77 87";

// Tax Deadlines
"help.deadlines" = "What are the tax deadlines?";
"help.deadlines.desc" = "Important dates and extensions";
"help.deadlines.content" = "Swiss tax calendar:\n\n• March 31: Regular deadline\n• May-June: Extended deadline (with request)\n• September: Maximum extension (with advisor)\n\nExpat benefits:\n• Automatic deadline extensions\n• Additional time for foreign documents\n• Professional support included\n\nNeed an extension? Contact info@taxed.ch";

// Account & Privacy
"help.account_privacy" = "How is my data protected?";
"help.account_privacy.desc" = "Security and privacy measures";
"help.account_privacy.content" = "Your data security is our priority:\n\n• End-to-end encryption\n• Swiss data protection law compliance\n• Secure cloud storage (AWS)\n• Regular security audits\n• No data sharing with third parties\n\nYou can:\n• Export your data anytime\n• Delete your account\n• Request data corrections\n\nPrivacy questions: info@taxed.ch";

// Pricing & Payment
"help.pricing" = "How much does it cost?";
"help.pricing.desc" = "Transparent pricing information";
"help.pricing.content" = "Our pricing is simple and transparent:\n\n• Basic tax return: CHF 99\n• Expat services: CHF 149\n• Complex cases: CHF 199\n• Expert consultation: CHF 50/hour\n\nIncluded in all plans:\n• Unlimited document uploads\n• AI analysis\n• Email support\n• Secure storage\n\nQuestions: info@taxed.ch";

// Contact Support
"help.contact" = "How do I contact support?";
"help.contact.desc" = "Get in touch with our team";
"help.contact.content" = "We're here to help!\n\nEmail: info@taxed.ch\nPhone: +41 79 910 77 87\n\nOffice Hours:\nMonday - Friday: 9:00 - 18:00\nSaturday: Closed\nSunday: Closed\n\nOffice Location:\nTaxed GmbH\nAegertenstrasse 10\n2503 Biel/Bienne\nSwitzerland\n\nAverage response time: 2-4 hours";

