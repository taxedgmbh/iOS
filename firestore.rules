rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId);
    }

    // Customers collection - User profile and settings
    match /customers/{customerId} {
      allow get: if isAuthenticated() && isOwner(customerId);
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(customerId);
      allow update: if isAuthenticated() && isOwner(customerId);
      allow delete: if isAuthenticated() && isOwner(customerId);
    }
    
    // Documents collection - CRITICAL FOR UPLOAD
    match /documents/{documentId} {
      // Allow get (single document read)
      allow get: if isAuthenticated() && isOwner(resource.data.customerId);

      // Allow list (queries) - user can query their own documents
      allow list: if isAuthenticated();

      allow create: if isAuthenticated() && isOwner(request.resource.data.customerId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.customerId);
    }
    
    // Chats collection - Real-time chat between customer and expert
    match /chats/{chatId} {
      // Allow list/get if user is customer or expert in the chat
      // For queries: Firestore validates query constraints match these rules
      allow get: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.expertId == request.auth.uid
      );

      // Allow list (queries) - this enables .whereField() queries
      // User can query chats where they are customer or expert
      allow list: if isAuthenticated();

      // Allow create if user is customer or expert in the chat
      allow create: if isAuthenticated() && (
        request.resource.data.customerId == request.auth.uid ||
        request.resource.data.expertId == request.auth.uid
      );

      // Allow update if user is customer or expert in the chat
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.expertId == request.auth.uid
      );
    }
    
    // Messages collection
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
    }
  }
}
