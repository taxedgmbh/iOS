rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper function to check if user is a member of a workspace
    function isWorkspaceMember(workspaceId) {
      return workspaceId != null &&
             request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId);
    }

    // Customers collection - User profile and settings
    match /customers/{customerId} {
      allow get: if isAuthenticated() && isOwner(customerId);
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(customerId);
      allow update: if isAuthenticated() && isOwner(customerId);
      allow delete: if isAuthenticated() && isOwner(customerId);
    }
    
    // Documents collection - CRITICAL FOR SECURITY
    // Tax documents contain highly sensitive financial data and MUST be protected
    match /documents/{documentId} {
      // Allow get (single document read) - user must own document OR be workspace member
      allow get: if isAuthenticated() && (
        isOwner(resource.data.customerId) ||
        (resource.data.workspaceId != null && isWorkspaceMember(resource.data.workspaceId))
      );

      // Allow list (queries) - STRICT enforcement of ownership or workspace membership
      // This prevents ANY authenticated user from querying ALL documents
      allow list: if isAuthenticated() && (
        // User is querying their own documents (legacy single-user mode)
        (request.query.where.customerId == request.auth.uid) ||
        // User is querying workspace documents where they are a member
        (request.query.where.workspaceId != null && isWorkspaceMember(request.query.where.workspaceId))
      );

      // Allow create - user must own document AND (if workspace) be a member
      allow create: if isAuthenticated() &&
                      isOwner(request.resource.data.customerId) &&
                      (request.resource.data.workspaceId == null ||
                       isWorkspaceMember(request.resource.data.workspaceId));

      // Allow update/delete - user must own document OR be workspace member
      allow update, delete: if isAuthenticated() && (
        isOwner(resource.data.customerId) ||
        (resource.data.workspaceId != null && isWorkspaceMember(resource.data.workspaceId))
      );
    }
    
    // Chats collection - Real-time chat between customer and expert
    match /chats/{chatId} {
      // Allow list/get if user is customer or expert in the chat
      // For queries: Firestore validates query constraints match these rules
      allow get: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.expertId == request.auth.uid
      );

      // Allow list (queries) - this enables .whereField() queries
      // User can query chats where they are customer or expert
      allow list: if isAuthenticated();

      // Allow create if user is customer or expert in the chat
      allow create: if isAuthenticated() && (
        request.resource.data.customerId == request.auth.uid ||
        request.resource.data.expertId == request.auth.uid
      );

      // Allow update if user is customer or expert in the chat
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.expertId == request.auth.uid
      );
    }
    
    // Messages collection
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Workspaces collection - Collaborative tax filing
    match /workspaces/{workspaceId} {
      // Helper function to check if user is a member of this workspace
      function isWorkspaceMember() {
        return isAuthenticated() &&
               request.auth.uid in resource.data.memberIds;
      }

      // Helper function to check if user is owner or admin
      function hasAdminAccess() {
        return isAuthenticated() && (
          resource.data.ownerId == request.auth.uid
        );
      }

      // Helper function to check if user can create (must be in memberIds list)
      function canCreate() {
        return isAuthenticated() &&
               request.auth.uid in request.resource.data.memberIds;
      }

      // Read: All members can read workspace
      allow get: if isWorkspaceMember();

      // List: Allow queries where user is in memberIds array
      allow list: if isAuthenticated();

      // Create: User must be authenticated and in the memberIds array
      allow create: if canCreate();

      // Update: Only members can update workspace
      allow update: if isWorkspaceMember();

      // Delete: Only owner can delete workspace
      allow delete: if hasAdminAccess();
    }

    // Workspace Invitations collection
    match /workspaceInvitations/{invitationId} {
      // Read: User can read invitations sent to their email or created by them
      allow get: if isAuthenticated() && (
        resource.data.invitedEmail == request.auth.token.email ||
        resource.data.invitedByUserId == request.auth.uid
      );

      // List: Allow queries for user's invitations
      allow list: if isAuthenticated();

      // Create: Authenticated users can create invitations
      allow create: if isAuthenticated();

      // Update: Only invitee or inviter can update
      allow update: if isAuthenticated() && (
        resource.data.invitedEmail == request.auth.token.email ||
        resource.data.invitedByUserId == request.auth.uid
      );

      // Delete: Only inviter can delete
      allow delete: if isAuthenticated() &&
                      resource.data.invitedByUserId == request.auth.uid;
    }

    // Tax Indexes collection - Read-only reference data
    // Contains canton-specific tax return index numbers, legal references, and deductibility rules
    match /taxIndexes/{indexId} {
      // Read: All authenticated users can read tax indexes
      // This is reference data needed for tax document categorization
      allow read: if isAuthenticated();

      // Write: Only server-side operations can write
      // Data is uploaded via Firebase Admin SDK (not from client apps)
      allow write: if false;
    }
  }
}
