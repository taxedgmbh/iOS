<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Partial Info.plist.

  GENERATE_INFOPLIST_FILE stays on and Xcode merges its generated keys into
  this file, so everything else still lives in build settings as
  INFOPLIST_KEY_*. Only what those settings cannot express belongs here.

  CFBundleURLTypes is exactly that. The project carried it as
  `INFOPLIST_KEY_CFBundleURLTypes[0]CFBundleURLSchemes[0]`, which looks
  plausible and produces nothing — the built Info.plist had no CFBundleURLTypes
  key at all. Without the scheme, Google's OAuth callback has nowhere to return
  to, so Sign in with Google could never have completed in any build that
  shipped with that setting.

  The value is REVERSED_CLIENT_ID from GoogleService-Info.plist. If the Firebase
  iOS client id is ever regenerated, this has to change with it.

  Kept outside TaxedGmbH_IOS/ on purpose: that folder is a
  PBXFileSystemSynchronizedRootGroup, so an Info.plist inside it would be picked
  up as a bundle resource as well as the target's Info.plist, and the build
  fails with "Multiple commands produce Info.plist".
-->
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Google Sign-In</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1041568476163-oh2igl7lechm5kpkrbjta0etlk4one74</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
